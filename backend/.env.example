# BizInvite backend configuration. Copy to .env and fill in real values.
# Never commit real secrets.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Must point at the bizinvite_db database (user bizinvite_app, readWrite@bizinvite_db).
# Example: mongodb+srv://bizinvite_app:<password>@<cluster-host>/bizinvite_db?retryWrites=true&w=majority
MONGODB_URI=

# Use long random values (e.g. `openssl rand -hex 48`). Access and refresh secrets must differ.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Background jobs (campaigns, reminders, imports, exports) are stored in MongoDB (scheduledJobs)
# and run by a scheduler inside the API process. Set to false only on API instances when a
# separate `npm run start:worker` process runs the scheduler instead.
SCHEDULER_ENABLED=true

# Comma-separated list of allowed browser origins, or set FRONTEND_URL
CORS_ORIGIN=http://localhost:3000,https://event.tirvona.com
FRONTEND_URL=https://event.tirvona.com

# Official WhatsApp Business Cloud API (Meta). Required in production.
# In development, leaving WHATSAPP_ACCESS_TOKEN empty enables a log-only dry-run sender.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# S3-compatible object storage (report exports). Optional in development.
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# HMAC secret for signing digital pass QR tokens. Use a long random value.
QR_SIGNING_SECRET=

LOG_LEVEL=info
