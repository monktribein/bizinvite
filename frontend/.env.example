# BizInvite Frontend Environment Configuration

# Base URL for the future BizInvite REST Backend (Node.js/Express)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Set to "true" to use local in-memory Mock API adapter with realistic seed data
# Set to "false" to connect to real backend at NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_USE_MOCK_API=false
